{
  "$schema": "../../core/theme.schema.json",

  "contractVersion": 1,

  "capabilities": {
    "social": { "render": "icons", "fallback": "text" },
    "analytics": ["googleAnalytics", "plausible"],
    "comments": ["disqus"],
    "search": false
  },

  "themeFeatures": [
    {
      "name": "code-highlighting",
      "entry": "features/code-highlighting/index.js"
    },
    {
      "name": "back-to-top",
      "entry": "features/back-to-top/index.js"
    }
  ],

  "build": {
    "purgeCSS": {
      "safelist": {
        "deep": [
          "data-theme",
          "data-component",
          "language-",
          "code",
          "pre",
          "token",
          "diff-highlight",
          "back-to-top"
        ],
        "greedy": ["language-"]
      }
    },
    "postcss": {
      "plugins": [
        {
          "package": "postcss-preset-env",
          "options": {
            "stage": 3,
            "features": {
              "nesting-rules": true,
              "custom-properties": true,
              "custom-media-queries": true
            }
          }
        },
        {
          "package": "cssnano",
          "production": true,
          "options": {
            "preset": [
              "default",
              {
                "discardComments": { "removeAll": true },
                "normalizeWhitespace": true,
                "colormin": true,
                "minifyFontValues": true
              }
            ]
          }
        }
      ]
    }
  },

  "assets": {
    "styles": {
      "entry": "styles/main.scss"
    },
    "scripts": {
      "entry": "scripts/main.js"
    }
  },

  "config": {
    "themeToggle": {
      "defaultTheme": "auto",
      "showToggle": true
    },
    "colors": {
      "light": {
        "background": "#ffffff",
        "surface": "#f5f5f5",
        "primary": "#1a1a1a",
        "secondary": "#525252",
        "accent": "#9b3b54",
        "text": "#262626",
        "textMuted": "#737373",
        "link": "#1a1a1a",
        "linkHover": "#9b3b54",
        "linkVisited": "#595959",
        "border": "#d4d4d4"
      },
      "dark": {
        "background": "#171717",
        "surface": "#262626",
        "primary": "#f5f5f5",
        "secondary": "#737373",
        "accent": "#9b3b54",
        "text": "#e5e5e5",
        "textMuted": "#a3a3a3",
        "link": "#fafafa",
        "linkHover": "#9b3b54",
        "linkVisited": "#a3a3a3",
        "border": "#404040"
      }
    },
    "typography": {
      "fontFamily": "-apple-system, system-ui, sans-serif",
      "fontFamilyHeading": "inherit",
      "fontFamilyMono": "'Consolas', 'Monaco', monospace",
      "fontSize": "1rem",
      "lineHeight": "1.6"
    },
    "navigation": {
      "showHomeLink": true,
      "pagination": {
        "enabled": true,
        "pageSize": 10
      }
    },
    "codeHighlighting": {
      "prismTheme": "prism-tomorrow",
      "diffHighlight": true
    },
    "footer": {
      "copyright": "{year} {site.title}",
      "alignment": "center",
      "showPoweredBy": true,
      "showGitSha": true
    }
  }
}
