{#
  Social links partial
  Iterates through site.social and renders icons
  Supports both account-based URLs and custom URLs
#}
{% if site and site.social and site.social.length %}
  <nav class="social-links" aria-label="Social media links">
    {% for social in site.social %}
      <a
        href="{{ social | socialUrl | safeUrl | escapeAttr }}"
        class="social-link social-link--{{ social.platform | escapeAttr }}"
        rel="me noopener noreferrer"
        target="_blank"
        aria-label="{{ social | socialLabel | escapeAttr }}"
      >
        {% include "partials/social/icon.njk" %}
      </a>
    {% endfor %}
  </nav>
{% endif %}
