<ol
  reversed
  class="postlist"
  style="--postlist-index: {{ (postslistCounter or postslist.length) + 1 }}"
>
  {%- for post in postslist | reverse %}
    <li class="postlist-item{% if post.url == url %}postlist-item-active{% endif %}">
      <a href="{{ post.url | safeUrl }}" class="postlist-link"
        >{% if post.data.title %}
          {{ post.data.title | escapeHtml }}
        {% else %}
          <code>{{ post.url | escapeHtml }}</code>
        {% endif %}</a
      >
      <time class="postlist-date" datetime="{{ post.date | dateToFormat('yyyy-LL-dd') }}"
        >{{ post.date | dateToFormat("LLLL yyyy") }}</time
      >
    </li>
  {%- endfor %}
</ol>
