<!doctype html>
<html
  lang="{{ site.language | escapeAttr }}"
  data-default-theme="{{ theme.themeToggle.defaultTheme | default('auto') | escapeAttr }}"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ (title or site.title) | escapeHtml }}</title>
    <meta name="description" content="{{ (description or site.description) | escapeAttr }}" />

    {# Favicon from theme config #}
    {% if theme and theme.logos and theme.logos.favicon %}
      <link rel="icon" href="{{ theme.logos.favicon | safeUrl | escapeAttr }}" />
    {% endif %}

    {% if theme.features.rss %}
      {# Absolute URL: correct for feed autodiscovery and stops the build's
         bundler from inlining a small feed.xml as a data: URI. #}
      <link
        rel="alternate"
        href="{{ (((site.url or '') | replace(r/\/$/, '')) ~ (theme.feedUrl | default('/feed.xml'))) | safeUrl | escapeAttr }}"
        type="application/atom+xml"
        title="{{ site.title | escapeAttr }}"
      />
    {% endif %}

    <meta name="generator" content="{{ eleventy.generator | escapeAttr }}" />

    {# Theme CSS custom properties #}
    {% include "partials/theme/styles.njk" %}

    {# Analytics (Google Analytics, Plausible) #}
    {% include "partials/head/analytics.njk" %}

    {# Vite will handle CSS imports from JS - no need for separate CSS links #}
  </head>
  <body class="page-{{ page.fileSlug | escapeAttr }}">
    <a href="#main" id="skip-link" class="visually-hidden">Skip to main content</a>

    <header>
      {# Logo or site title #}
      {% if theme and theme.logos and theme.logos.default %}
        <a href="/" class="home-link">
          <img
            src="{{ theme.logos.default | safeUrl | escapeAttr }}"
            alt="{{ site.title | escapeAttr }}"
            class="site-logo"
          />
        </a>
      {% else %}
        <a href="/" class="home-link">{{ site.title | escapeHtml }}</a>
      {% endif %}

      {#- Read more about `eleventy-navigation` at https://www.11ty.dev/docs/plugins/navigation/ #}
      <nav>
        <h2 class="visually-hidden">Top level navigation menu</h2>
        <ul class="nav">
          {# Home link (controlled by theme config) #}
          {% if theme and theme.navigation and theme.navigation.showHomeLink %}
            <li class="nav-item">
              <a href="/" {% if page.url == "/" %}aria-current="page"{% endif %}>Home</a>
            </li>
          {% endif %}
          {%- for entry in collections.all | eleventyNavigation %}
            <li class="nav-item">
              <a
                href="{{ entry.url | safeUrl }}"
                {% if entry.url == page.url %}aria-current="page"{% endif %}
                >{{ entry.title | escapeHtml }}</a
              >
            </li>
          {%- endfor %}
        </ul>
      </nav>

      {# Dark mode toggle #}
      {% include "partials/theme/toggle.njk" %}
    </header>

    <main id="main">
      <heading-anchors> {{ content | safe }} </heading-anchors>
    </main>

    <footer>
      {# Footer navigation: secondary menu (left) and social links (right) #}
      <div class="footer-nav">
        {# Secondary footer menu (T&Cs, Privacy, etc.) #}
        {% include "partials/footer/menu.njk" %}

        {# Social links #}
        {% include "partials/social/links.njk" %}
      </div>

      <div
        class="footer-bottom footer-bottom--{{ theme.footer.alignment | default('center') | escapeAttr }}"
      >
        {# Copyright #}
        {% include "partials/footer/copyright.njk" %}

        {# Powered by Eleventy #}
        {% include "partials/footer/powered-by.njk" %}

        {# Git SHA #}
        {% include "partials/footer/git-sha.njk" %}
      </div>
    </footer>

    {% if build.timestamp %}<!-- This page `{{ page.url | escapeHtml }}` was built on {{ build.timestamp | escapeHtml }} -->{% endif %}

    {# Global JavaScript - Vite will process and bundle #}
    {# User's main.js imports theme styles/scripts #}
    <script type="module" src="/assets/scripts/main.js"></script>

    {# Page-specific JavaScript features (opt-in via front matter) #}
    {# Supports both single feature string and array of features #}
    {% if features %}
      {% if features is string %}
        {% set safeName = features | safeFeatureName %}
        {% if safeName %}<script type="module" src="/{{ safeName }}.js"></script>{% endif %}
      {% else %}
        {% for f in features %}
          {% set safeName = f | safeFeatureName %}
          {% if safeName %}<script type="module" src="/{{ safeName }}.js"></script>{% endif %}
        {% endfor %}
      {% endif %}
    {% endif %}
  </body>
</html>
